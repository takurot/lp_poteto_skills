{
  "ci": {
    "collect": {
      "startServerCommand": "npx wrangler dev --ip 127.0.0.1 --port 8788",
      "startServerReadyPattern": "Ready on",
      "startServerReadyTimeout": 60000,
      "url": ["http://127.0.0.1:8788/", "http://127.0.0.1:8788/ja/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./temp/lhci"
    }
  }
}
